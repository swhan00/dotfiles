# Locale: LANG supplies the default without forcing every LC_* category.
export LANG=ko_KR.UTF-8
unset LC_ALL LANGUAGE

# Use zsh's tied PATH array and keep the first occurrence of each entry.
typeset -U path PATH

# Python: pyenv manages interpreters; pyenv-virtualenv manages environments.
export PYENV_ROOT="${PYENV_ROOT:-$HOME/.pyenv}"
if [[ -d "$PYENV_ROOT/bin" ]]; then
  path=("$PYENV_ROOT/bin" "${path[@]}")
fi
if [[ -o interactive ]] && command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init - zsh)"
  if pyenv commands | command grep -qx virtualenv-init; then
    eval "$(pyenv virtualenv-init -)"
  fi
  if dotfiles_python="$(pyenv which python 2>/dev/null)"; then
    export CLOUDSDK_PYTHON="$dotfiles_python"
  fi
  unset dotfiles_python
fi

# Node.js
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ -o interactive && -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
  if [[ -s "$NVM_DIR/bash_completion" ]]; then
    source "$NVM_DIR/bash_completion"
  fi
fi

# Android SDK
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
for dotfiles_bin in "$ANDROID_HOME/emulator" "$ANDROID_HOME/platform-tools"; do
  if [[ -d "$dotfiles_bin" ]]; then
    path=("$dotfiles_bin" "${path[@]}")
  fi
done
unset dotfiles_bin

# Antigravity
if [[ -d "$HOME/.antigravity/antigravity/bin" ]]; then
  path=("$HOME/.antigravity/antigravity/bin" "${path[@]}")
fi

# LM Studio CLI (lower priority than existing commands)
if [[ -d "$HOME/.lmstudio/bin" ]]; then
  path+=("$HOME/.lmstudio/bin")
fi

# MuseScore
if [[ -x "/Applications/MuseScore 4.app/Contents/MacOS/mscore" ]]; then
  export MUSESCORE_PATH="/Applications/MuseScore 4.app/Contents/MacOS/mscore"
fi

# Machine-local settings, including credentials, stay outside version control.
if [[ -r "$HOME/.zshrc_local" ]]; then
  source "$HOME/.zshrc_local"
fi
