# Locale
export LC_ALL=ko_KR.UTF-8
export LANG=en_US.UTF-8
export LANGUAGE=en_US.UTF-8


# Homebrew
HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"


# Python
if [[ -d $HOMEBREW_PREFIX/opt/python@3.11/libexec/bin ]]; then
  export PATH="$HOMEBREW_PREFIX/opt/python@3.11/libexec/bin:$PATH"
fi
export WORKON_HOME=$HOME/.virtualenvs
[[ -f $HOMEBREW_PREFIX/bin/virtualenvwrapper.sh ]] && source $HOMEBREW_PREFIX/bin/virtualenvwrapper.sh

export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv >/dev/null; then
  eval "$(pyenv init -)"
  export CLOUDSDK_PYTHON="$(pyenv which python 2>/dev/null)"
fi


# Node.js
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion


# Android SDK
export ANDROID_HOME="$HOME/Library/Android/sdk"
[[ -d $ANDROID_HOME ]] && export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"


# Antigravity
[[ -d $HOME/.antigravity/antigravity/bin ]] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"


# Machine-local settings (not in git)
[[ -f ~/.zshrc_local ]] && source ~/.zshrc_local
